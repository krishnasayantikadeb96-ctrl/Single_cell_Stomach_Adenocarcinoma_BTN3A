# Phase-Specific Co-Expression Analysis (Spearman Correlation)

#' Function to calculate Spearman correlation partners for a target gene in a given phase
find_partners_by_phase <- function(cds_obj, phase_name, target_gene = "BTN3A3", top_n = 30) {
  # Subset CDS to the target phase
  cds_subset <- cds_obj[, colData(cds_obj)$trajectory_phase == phase_name]
  expr_mat   <- normalized_counts(cds_subset)

  if (!(target_gene %in% rownames(expr_mat))) {
    message(paste(target_gene, "not found in phase:", phase_name))
    return(NULL)
  }

  target_vec <- as.numeric(expr_mat[target_gene, ])

  # Calculate Spearman correlation across all expressed genes
  cor_vals <- apply(expr_mat, 1, function(x) {
    if (sum(x) == 0) return(0)
    cor(as.numeric(x), target_vec, method = "spearman")
  })

  # Rank top partners
  partner_df <- data.frame(
    gene_short_name = names(cor_vals),
    correlation     = cor_vals,
    phase           = phase_name
  ) %>%
    filter(gene_short_name != target_gene) %>%
    filter(!is.na(correlation)) %>%
    arrange(desc(correlation)) %>%
    head(top_n)

  return(partner_df)
}

# Run Spearman co-expression analysis for each phase
early_partners <- find_partners_by_phase(t_cell_cds, "Early", target_gene = "BTN3A3")
mid_partners   <- find_partners_by_phase(t_cell_cds, "Mid",   target_gene = "BTN3A3")
late_partners  <- find_partners_by_phase(t_cell_cds, "Late",  target_gene = "BTN3A3")

# Combine results into a consolidated data frame
all_phase_partners <- rbind(early_partners, mid_partners, late_partners)


