#' Helper Function: Identify Root Node based on Naive Marker 

get_earliest_principal_node <- function(cds, marker_gene = "SELL") {
  marker_expression <- exprs(cds)[rowData(cds)$gene_short_name == marker_gene, ]
  root_cell <- names(which.max(marker_expression))
  closest_vertex <- cds@principal_graph_aux[["UMAP"]]$pr_graph_cell_proj_closest_vertex
  root_node <- closest_vertex[root_cell, ]
  return(paste0("Y_", root_node))
}

# Seurat Subsetting & Monocle3 CDS Conversion
#Load Integrated Seurat Object
seurat_obj <- integrated_object_clean_resumed
DefaultAssay(seurat_obj) <- "RNA"

# Define T-cell cluster IDs and subset
t_cell_clusters <- c("0", "9", "22", "15", "12", "1", "6")
t_cell_seurat <- subset(seurat_obj, subset = seurat_clusters %in% t_cell_clusters)

# Standard preprocessing on T-cell subset
t_cell_seurat <- NormalizeData(t_cell_seurat) %>%
  FindVariableFeatures(selection.method = "vst", nfeatures = 2000) %>%
  ScaleData() %>%
  RunPCA(npcs = 30, verbose = FALSE) %>%
  RunUMAP(dims = 1:30, verbose = FALSE)

# Extract counts and metadat
t_cell_seurat <- JoinLayers(t_cell_seurat)
expr_matrix <- LayerData(t_cell_seurat, assay = "RNA", layer = "data")
cell_meta   <- t_cell_seurat@meta.data[colnames(expr_matrix), , drop = FALSE]
gene_meta   <- data.frame(
  gene_short_name = rownames(expr_matrix), 
  row.names = rownames(expr_matrix)
)

# Construct Monocle 3 Cell Data Set (CDS)
t_cell_cds <- new_cell_data_set(
  expression_data = expr_matrix,
  cell_metadata   = cell_meta,
  gene_metadata   = gene_meta
)

# Transfer Seurat PCA & UMAP embeddings directly to CDS
cds_barcodes <- colnames(t_cell_cds)
reducedDims(t_cell_cds)$PCA  <- as.matrix(t_cell_seurat@reductions$pca@cell.embeddings)[cds_barcodes, ]
reducedDims(t_cell_cds)$UMAP <- as.matrix(t_cell_seurat@reductions$umap@cell.embeddings)[cds_barcodes, ]

# Clustering, Graph Learning & Rooting
# Cluster cells with higher k to force mainland connectivity
t_cell_cds <- cluster_cells(t_cell_cds, k = 50)

# Filter for main mainland partition (Partition 1)
t_cell_cds <- t_cell_cds[, partitions(t_cell_cds) == "1"]

# Learn trajectory principal graph
t_cell_cds <- learn_graph(t_cell_cds)

# Root trajectory at peak Naive marker expression 
root_node <- get_earliest_principal_node(t_cell_cds, marker_gene = "SELL")
t_cell_cds <- order_cells(t_cell_cds, root_pr_nodes = root_node)


