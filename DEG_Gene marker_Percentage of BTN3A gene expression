# percentage of BTN3A
library(Seurat)
library(dplyr)
library(readr)
# Define the gene of interest and the assay to use
gene_name <- "BTN3A2"
assay_name <- "SCT"

# Calculate the expression summary table
expression_data <- GetAssayData(
  object = integrated_object_clean_resumed,
  assay = assay_name,
  layer = "data"
)[gene_name, ]

cluster_data <- integrated_object_clean_resumed@meta.data %>%
  dplyr::select(seurat_clusters)

expression_summary <- cluster_data %>%
  mutate(BTN3A2_Expression = expression_data[rownames(cluster_data)]) %>%
  mutate(is_expressed = BTN3A2_Expression > 0) %>%
  group_by(seurat_clusters) %>%
  summarise(
    Total_Cells = n(),
    Cells_Expressing_BTN3A2 = sum(is_expressed),
    Percentage_Expressing = (Cells_Expressing_BTN3A2 / Total_Cells) * 100
  ) %>%
  arrange(desc(Percentage_Expressing))

#  Save the table to a CSV file 
readr::write_csv(expression_summary, "BTN3A2_Expression_Per_Cluster_Summary.csv")

print("The table has been saved to BTN3A2_Expression_Per_Cluster_Summary.csv in your working directory.")
