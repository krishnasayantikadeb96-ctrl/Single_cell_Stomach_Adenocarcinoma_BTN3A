# Overall DEGs
library(Seurat)
library(readr)
library(dplyr)
library(tibble)

# Set the default assay to "RNA"
DefaultAssay(integrated_object_clean_resumed) <- "RNA"
print("Default assay set to 'RNA'.")

# Re-normalize the RNA assay (to ensure the 'data' layer is populated, as previously advised)
integrated_object_clean_resumed <- NormalizeData(integrated_object_clean_resumed)
print("RNA assay normalized.")

#  CRITICAL FIX: Join Layers 
# This resolves the "data layers are not joined" error.
integrated_object_clean_resumed <- JoinLayers(integrated_object_clean_resumed)
print("RNA layers joined successfully.")

# Prepare the object (ensure factor levels are correct)
integrated_object_clean_resumed@meta.data$group <- factor(
  integrated_object_clean_resumed@meta.data$group,
  levels = c("Normal", "Tumor")
)

#  Run FindMarkers()
print("Running FindMarkers() on the joined RNA assay...")

deg_overall_tumor_vs_normal <- FindMarkers(
  object = integrated_object_clean_resumed,
  ident.1 = "Tumor",
  ident.2 = "Normal",
  group.by = "group",
  min.pct = 0.1,
  logfc.threshold = 0.25,
  test.use = "wilcox"
)

# Check BTN3A3 and save the results
btn3a1_overall_result <- deg_overall_tumor_vs_normal["BTN3A1", ]

readr::write_csv(
  deg_overall_tumor_vs_normal %>% tibble::rownames_to_column("gene"),
  "DEG_Overall_Tumor_vs_Normal_RNAAssay_Joined.csv"
)

print("--- Overall Differential Expression Complete ---")
print(btn3a1_overall_result)
print(paste("Full DEG table saved to:", "DEG_Overall_Tumor_vs_Normal_RNAAssay_Joined.csv"))
