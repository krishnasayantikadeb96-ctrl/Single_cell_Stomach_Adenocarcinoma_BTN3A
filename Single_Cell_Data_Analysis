# Load integrated object from step 1
integrated_object_clean_resumed <- readRDS(file = "./results/harmony_integrated_final.rds")

# Define Annotation Marker Genes
annotation_markers <- c("LEF1", "SELL", "CCR7", "CD8A", "GZMH", "GZMM", "NKG7", "GZMK", "EOMES", "GNLY", "GZMB", "CCL5", "GZMA", "TRAC", "FOXP3",
  "CTLA4", "TRAC", "KDM5D", "IFIT2", "CCL3", "IL2RA", "CCL5", "GZMK"
)

# Set the Identity to the final cluster numbers
Idents(integrated_object_clean_resumed) <- integrated_object_clean_resumed$seurat_clusters
cluster_cols_names <- sort(unique(as.character(Idents(integrated_object_clean_resumed))))

# Calculate Average Expression
avg_expression_matrix <- Seurat::AverageExpression(
  integrated_object_clean_resumed,
  features = annotation_markers,
  assays = "SCT"
)$SCT

# Calculate Percentage of Cells Expressing
pct_expressed_matrix <- apply(
  X = GetAssayData(integrated_object_clean_resumed, assay = "SCT", layer = "data")[annotation_markers, ],
  MARGIN = 1, FUN = function(x) {
    tapply(X = x, INDEX = Idents(integrated_object_clean_resumed), FUN = function(y) {
      sum(y > 0) / length(y)
    })
  }
)

# Convert to Tidy Format and Merge (Base R reshape)
avg_df <- as.data.frame(avg_expression_matrix)
avg_df$Gene <- rownames(avg_df)
cluster_cols <- colnames(avg_df)[1:(ncol(avg_df) - 1)]

pct_matrix_transposed <- t(pct_expressed_matrix)
pct_df <- as.data.frame(pct_matrix_transposed)
colnames(pct_df) <- cluster_cols
pct_df$Gene <- rownames(pct_df)

avg_long <- reshape(data = avg_df, direction = "long", varying = list(cluster_cols), v.names = "avg.exp", timevar = "Cluster", times = cluster_cols)
pct_long <- reshape(data = pct_df, direction = "long", varying = list(cluster_cols), v.names = "pct.exp", timevar = "Cluster", times = cluster_cols)
dotplot_data_export_final <- merge(avg_long[, c("Gene", "Cluster", "avg.exp")], pct_long[, c("Gene", "Cluster", "pct.exp")], by = c("Gene", "Cluster"))

# EXPORT CSV
output_path <- "./results/manual_dotplot_data_for_visualization.csv"
write.csv(dotplot_data_export_final, file = output_path, row.names = FALSE)
print(paste("The final FIXED Dot Plot data has been successfully exported to:", output_path))

