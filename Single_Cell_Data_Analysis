# MODULAR QC AND DATA LOADING

process_sample_qc <- function(file_name, data_dir, sample_group) {
  full_path <- file.path(data_dir, file_name)
  sample_id <- gsub("\\.csv(\\.gz)?$", "", file_name)
  
  message(sprintf("Processing Sample: %s [%s]", sample_id, sample_group))
  
  if (!file.exists(full_path)) {
    warning(sprintf("File missing: %s. Skipping sample.", full_path))
    return(NULL)
  }
  
  tryCatch({
# Read count matrix
    counts <- read.csv(file = full_path, row.names = 1, check.names = FALSE)
    sparse_counts <- as(as.matrix(counts), "sparseMatrix")
    
# Initialize Seurat object
    seurat_obj <- CreateSeuratObject(counts = sparse_counts, project = sample_id, min.cells = 3)
    
# Metadata & QC Metrics
    seurat_obj[["percent.mt"]] <- PercentageFeatureSet(seurat_obj, pattern = "^MT-")
    seurat_obj$group <- sample_group
    seurat_obj$sample_id <- sample_id
    
# Filter cells using predefined thresholds
    cells_before <- ncol(seurat_obj)
    seurat_obj <- subset(
      x = seurat_obj,
      subset = nFeature_RNA >= MIN_FEATURES & 
               nFeature_RNA <= MAX_FEATURES & 
               percent.mt <= MAX_MITO_PERCENT
    )
    cells_after <- ncol(seurat_obj)
    
    message(sprintf("   Retained %d / %d cells (%.2f%%)", 
                    cells_after, cells_before, (cells_after / cells_before) * 100))
    
    return(seurat_obj)
  }, error = function(e) {
    message(sprintf("Failed to process %s: %s", sample_id, e$message))
    return(NULL)
  })
}

# Load and quality-filter Normal and Tumor cohorts
normal_list <- compact(lapply(normal_files, process_sample_qc, data_dir = DATA_DIR, sample_group = "Normal"))
tumor_list  <- compact(lapply(tumor_files,  process_sample_qc, data_dir = DATA_DIR, sample_group = "Tumor"))

if (length(normal_list) == 0 || length(tumor_list) == 0) {
  stop("Critical Error: Pipeline halted due to missing input files.")
}

# Merge sample lists into group objects
normal_object <- merge(x = normal_list[[1]], y = normal_list[-1], add.cell.ids = names(normal_list))
tumor_object  <- merge(x = tumor_list[[1]],  y = tumor_list[-1],  add.cell.ids = names(tumor_list))

# Save group RDS files
saveRDS(normal_object, file.path(OUTPUT_DIR, "normal_object_qc.rds"))
saveRDS(tumor_object,  file.path(OUTPUT_DIR, "tumor_object_qc.rds"))


# HARMONY INTEGRATION & SCTRANSFORM
message("--- Merging Cohorts for Integration ---")
combined_object <- merge(
  x = normal_object,
  y = tumor_object,
  add.cell.ids = c("N", "T"),
  project = "ScRNA_Harmony_Study"
)

# Join raw count layers prior to normalization
combined_object <- JoinLayers(combined_object, assay = "RNA")

message("--- Running SCTransform Normalization ---")
combined_object <- SCTransform(
  object = combined_object,
  assay = "RNA",
  vst.flavor = "v2",
  conserve.memory = TRUE,
  verbose = FALSE
)

# Dimensionality reduction
combined_object <- RunPCA(combined_object, assay = "SCT", npcs = 50, verbose = FALSE)

message("--- Running Harmony Batch Correction ---")
combined_object <- RunHarmony(
  object = combined_object,
  group.by.vars = "sample_id",
  reduction.use = "pca",
  dims.use = 1:30,
  assay.compute = "SCT",
  verbose = FALSE
)

# Clustering & UMAP Visualization

combined_object <- FindNeighbors(combined_object, reduction = "harmony", dims = 1:30)
combined_object <- FindClusters(combined_object, resolution = 0.3)
combined_object <- RunUMAP(combined_object, reduction = "harmony", dims = 1:30)

# Global Cluster UMAP Plot
umap_clusters <- DimPlot(
  combined_object, 
  reduction = "umap", 
  group.by = "seurat_clusters", 
  label = TRUE, 
  repel = TRUE, 
  pt.size = 0.3
) + ggtitle("Integrated UMAP (Harmony Corrected)") + 
    theme_bw() + 
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))

# Side-by-Side Normal vs. Tumor Comparison Plot
umap_split <- DimPlot(
  combined_object, 
  reduction = "umap", 
  group.by = "seurat_clusters", 
  split.by = "group",
  label = TRUE, 
  repel = TRUE, 
  pt.size = 0.3
) + ggtitle("Integrated UMAP: Normal vs. Tumor") + 
    theme_bw() + 
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))

# Save Plots & Final Integrated Object
ggsave(file.path(OUTPUT_DIR, "UMAP_Clusters_Global.png"), plot = umap_clusters, width = 8, height = 7, dpi = 300)
ggsave(file.path(OUTPUT_DIR, "UMAP_Clusters_Split.png"),  plot = umap_split,    width = 14, height = 6, dpi = 300)

# Dotplot and Annotation:

library(Seurat)
